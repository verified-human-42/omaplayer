#!/bin/sh
# Cuts a release: bin/release 0.1.0
#
# Sets the version everywhere, runs the tests, tags and pushes, publishes the
# GitHub release, points packaging/omaplayer (what install.sh builds) at the
# release tarball with its checksum, and attaches a prebuilt package to the
# release for `sudo pacman -U`.
set -eu

VERSION=${1:?usage: bin/release VERSION}
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT"

[ -z "$(git status --porcelain)" ] || { echo "Commit or stash your changes first." >&2; exit 1; }
[ "$(git branch --show-current)" = main ] || { echo "Release from main." >&2; exit 1; }
git rev-parse "v$VERSION" >/dev/null 2>&1 && { echo "v$VERSION is already tagged." >&2; exit 1; }

sed -i "s/^VERSION = .*/VERSION = $VERSION/" omaplayer.pro
sed -i "s/^pkgver=.*/pkgver=$VERSION/; s/^pkgrel=.*/pkgrel=1/" pkgbuild/PKGBUILD packaging/omaplayer/PKGBUILD
sed -i "s/^sha256sums=.*/sha256sums=('SKIP')/" packaging/omaplayer/PKGBUILD

"$ROOT/bin/test"

git commit -qam "Release v$VERSION" || true
git tag -a "v$VERSION" -m "Omaplayer $VERSION"
git push -q origin main "v$VERSION"
gh release create "v$VERSION" --title "Omaplayer $VERSION" --generate-notes

# The tarball GitHub serves for the tag, checksummed for the package.
REPO=$(gh repo view --json url -q .url)
SUM=$(curl -fsSL "$REPO/archive/refs/tags/v$VERSION.tar.gz" | sha256sum | cut -d' ' -f1)
sed -i "s/^sha256sums=.*/sha256sums=('$SUM')/" packaging/omaplayer/PKGBUILD
git commit -qam "Point the package at v$VERSION"
git push -q origin main

# A prebuilt package on the release, built from that same tarball.
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
cp packaging/omaplayer/PKGBUILD "$WORK/"
(cd "$WORK" && makepkg -f --noconfirm >/dev/null)
gh release upload "v$VERSION" "$WORK"/omaplayer-"$VERSION"-*.pkg.tar.zst

echo "Released v$VERSION."
