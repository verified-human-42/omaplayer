pkgname=omaplayer
pkgver=0.9.0
pkgrel=1
pkgdesc='Omarchy-native media player built on mpv'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only')
depends=('mpv' 'qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'xdg-desktop-portal' 'hicolor-icon-theme')
optdepends=('yt-dlp: play stream URLs'
            'noto-fonts-cjk: Chinese, Japanese, and Korean file names and subtitles')
makedepends=('gcc' 'make' 'pkgconf')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omaplayer "$pkgdir/usr/bin/omaplayer"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "$startdir/omaplayer.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaplayer.svg"
  install -Dm644 "$startdir/omaplayer.desktop" "$pkgdir/usr/share/applications/omaplayer.desktop"
}
